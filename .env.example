# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it's already in .gitignore.
#
# All three are free to obtain:
#   - Razorpay test-mode keys: dashboard.razorpay.com -> Test Mode ->
#     Account & Settings -> API keys -> Generate Key (no KYC needed for test mode)
#   - Gemini API key: aistudio.google.com -> Get API key (free tier, no card needed)

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx
